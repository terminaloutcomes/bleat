    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSBonjourServices</key><array><string>_audiobookshelf._tcp</string></array>
    <key>NSLocalNetworkUsageDescription</key><string>Bleat connects to your Audiobookshelf server on the local network.</string>
