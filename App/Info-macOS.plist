    <key>BleatCloudKitMode</key><string>$(BLEAT_EFFECTIVE_CLOUDKIT_MODE)</string>
    <key>BleatDeveloperName</key><string>$(BLEAT_DEVELOPER_NAME)</string>
    <key>BleatTelemetryAttesterMode</key><string>$(BLEAT_TELEMETRY_ATTESTER_MODE)</string>
    <key>BleatTelemetryAuthenticationBaseURL</key><string>$(BLEAT_TELEMETRY_AUTH_BASE_URL)</string>
    <key>BleatTelemetryOTLPEndpoint</key><string>$(BLEAT_TELEMETRY_OTLP_ENDPOINT)</string>
